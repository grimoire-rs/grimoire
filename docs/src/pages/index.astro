---
// C-023 — the landing, rebuilt from `.agents/discovery/design/Main.dc.html`:
// header, hero with the cast beside it, the three entry paths, the eight
// router cards, the four-group nav, the site links.
//
// Three things this page no longer carries, and where each went:
//
//   * The bar. PR 1 hand-rolled a header here and hid Starlight's with CSS,
//     which left the mark, the four links and the version span written twice —
//     `Header.astro` says so in its own comment. The canvas draws one bar with
//     a search field in it, and `Header.astro` is that bar. So the override is
//     unhidden and the copy deleted. The version span goes with it: the same
//     `import.meta.env.GRIM_VERSION` now renders on all 34 pages instead of
//     one, and the `data-grim-version` attribute retires with the `seo.py`
//     stamping step that was its only reader.
//   * The footer. Same story: hidden here, hand-rolled below it, four of the
//     five links. `Footer.astro` carries all five plus `FooterNav`, on every
//     page, and `landing_check.py` reads them out of the rendered block.
//   * The cast. The inline `AsciinemaPlayer.create` call predates `casts.js`
//     (C-024) and had been broken since: the head array stopped shipping the
//     player bundle, so the landing called a global nothing defined. The
//     `[data-cast]` div is the supported embed, it loads the bundle on first
//     intersection, and it does not autoplay.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import WaysIn from '../components/WaysIn.astro';
import PainRouter from '../components/PainRouter.astro';

// `seo.py`'s page_url() special-cased the landing to the bare site root.
// Starlight derives the canonical and og:url from the route instead, which is
// `/index.html` — so the tag and the sitemap named two URLs for one page.
const home = Astro.site.href;
---

<StarlightPage
  frontmatter={{
    title: 'Grimoire',
    description:
      'Package manager for AI-agent config — skills, rules, agents, and MCP servers, installed into every coding agent you use',
    // `splash` is what sets hasSidebar: false and toc: false.
    template: 'splash',
    // The mdBook landing was never in the search index.
    pagefind: false,
    head: [
      // Preserves the shipped <title>; `getHead` drops its own title tag
      // when the page frontmatter supplies one.
      { tag: 'title', content: 'Grimoire — a lockfile for your AI-agent config' },
      { tag: 'meta', attrs: { name: 'theme-color', content: '#161826' } },
      { tag: 'link', attrs: { rel: 'canonical', href: home } },
      { tag: 'meta', attrs: { property: 'og:url', content: home } },
      // Starlight reads og:title from `title` above, not from the <title>
      // override, and hard-codes og:type to `article`. seo.py sent the full
      // headline and `website`; the landing is not an article.
      {
        tag: 'meta',
        attrs: {
          property: 'og:title',
          content: 'Grimoire — a lockfile for your AI-agent config',
        },
      },
      { tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
    ],
  }}
>
  {/*
    Starlight wraps every slot in `<div class="sl-markdown-content">`, whose
    `style/markdown.css` restyles prose from inside: 1rem of `margin-top` on
    every non-first sibling, a border and padding on every `pre`, `height:auto`
    on every `svg`. `not-content` is Starlight's own opt-out — every rule in
    that file is guarded with `:not(:where(.not-content *))` — so this one
    wrapper disables all of it at once, and survives a Starlight upgrade in a
    way a list of counter-rules would not.
  */}
  <div class="not-content">
    <div class="wrap">
      <section class="hero">
        <div>
          <h1>A lockfile for your AI-agent config.</h1>
          <p class="lede">
            Skills, rules, agents and MCP servers — declared once, pinned by digest,
            written into each coding agent in the format it actually reads. Storage is
            any OCI registry. There is no Grimoire service.
          </p>
          <div class="ctas">
            <a class="cta cta-primary" href="/installation.html">Install grim</a>
            <a class="cta cta-secondary" href="https://index.grimoire.rs">Open the index</a>
            <a class="cta cta-secondary" href="/start.html">Create your own</a>
          </div>
        </div>

        <div class="cast">
          <div class="cast-bar">
            <span class="cast-kicker">see it run</span>
            <span class="cast-note">real grim, real registry</span>
          </div>
          <div data-cast="/demo.cast" data-cast-poster="npt:0:03"></div>
          <noscript>
            <p class="cast-fallback">
              This demo needs JavaScript to play. The recording is plain text:{' '}
              <a href="/demo.cast">demo.cast</a>.
            </p>
          </noscript>
        </div>
      </section>

      <WaysIn />
      <PainRouter />
    </div>
  </div>
</StarlightPage>

<style is:global>
  /* The canvas's glow: one accent wash off the top-right corner over the page
     ground. It is the landing's alone — `theme.css` maps the palette for all
     34 pages and deliberately leaves the ground flat. */
  body {
    background:
      radial-gradient(
        1100px 640px at 88% -220px,
        color-mix(in srgb, var(--sl-color-accent-low) 62%, transparent),
        transparent 62%
      ),
      var(--sl-color-bg);
  }

  /* — the landing's own column —
     `Main.dc.html` is a 1160px column with 64px gutters. The bar and the
     footer get the same treatment below so the three line up. */
  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding-inline: clamp(20px, 5vw, 64px);
  }

  /* — hero — */
  .hero {
    padding: clamp(40px, 4.5vw, 60px) 0 clamp(36px, 3.6vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: 0 clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .hero h1 {
    font-weight: 500;
    font-size: clamp(32px, 3.4vw, 44px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    /* The negative inline start pulls the cap of the "A" onto the column
       edge; an optical correction, not a layout offset. */
    margin: 0 0 0 -0.04em;
    color: var(--sl-color-white);
  }

  .lede {
    font-size: 16.5px;
    line-height: 28px;
    margin: 22px 0 0;
    max-width: 46ch;
    color: var(--sl-color-gray-2);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 14.5px;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Ink on accent, not a token: this is the one place the palette needs a
     colour dark enough to read on `--sl-color-accent`, and no `--sl-color-*`
     is defined for it. */
  .cta-primary {
    color: #14121f;
    background: var(--sl-color-accent);
  }

  .cta-primary:hover {
    color: #14121f;
    background: var(--sl-color-accent-high);
  }

  .cta-secondary {
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-4);
  }

  .cta-secondary:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  /* — the cast, in the hero's right column — */
  .cast {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    overflow: hidden;
  }

  .cast-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    font-family: var(--sl-font-mono);
  }

  .cast-kicker {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
  }

  .cast-note {
    margin-inline-start: auto;
    font-size: 12px;
    color: var(--sl-color-gray-3);
  }

  .cast-fallback {
    margin: 0;
    padding: 12px 14px;
    font-family: var(--sl-font-mono);
    font-size: 12px;
    color: var(--sl-color-gray-3);
  }

  /* Single-column collapse. `minmax(0, 1fr)`, never bare `1fr` — a bare `fr`
     track floors at min-content, which the terminal's widest line pushes
     wider than the viewport. The zero floor lets the player scroll instead. */
  @media (max-width: 940px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px 0;
    }
  }

  /* — Starlight chrome, kept or dropped —
     The landing is a `splash` page rendered full-bleed inside Starlight's
     shell, so the frame is stripped back to the bar and the footer and the
     `.wrap` above supplies every gutter.

     Astro emits `is:global` styles unlayered and Starlight's own rules live in
     `@layer starlight.core`, so unlayered wins without `!important`. The one
     exception is `main`'s padding, which Starlight sets from an unlayered
     scoped rule in `Page.astro` — that one is out-specified instead. */

  /* The bar is Starlight's (C-020 `Header.astro`); the canvas centres it on
     the same 1160px column the content uses. PageFrame pads the fixed
     wrapper, so the padding moves inward onto the element that is now
     width-capped, or the two gutters would add up. */
  .page > .header {
    padding-inline: 0;
  }

  .page > .header > .header {
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 64px);
  }

  /* Starlight's own footer is the Edit-page link and prev/next; the landing is
     in neither the sidebar nor the repo's page tree, so both render empty. The
     chain matches only that one: `SiteFooter.astro`'s `<footer
     class="grim-footer">` is a sibling of `<main>`, not inside `.sl-container`,
     and it stays — that one is the four-group nav and the five site links. */
  main > .content-panel > .sl-container > footer {
    display: none;
  }

  /* Line the footer block up with the bar and the content. `SiteFooter.astro`
     reads these two, so the landing's wider column is a definition here rather
     than a rule out-specifying its scoped styles.

     The two numbers are not interchangeable. `.wrap` and the bar cap their
     OUTER box at 1160px and pad inward, so what a reader sees spans 1160px
     less both gutters. The footer's cap sits on `.inner`, inside the padding,
     so the same 1160px there ran the nav and the site links one full gutter
     wider on each side than everything above them. Subtract both. */
  .main-pane {
    --grim-footer-pad: clamp(20px, 5vw, 64px);
    --grim-footer-width: calc(1160px - 2 * var(--grim-footer-pad));
  }

  /* The landing carries its own headline, so Starlight's page title is taken
     out of the layout — but visually, not from the document. `SkipLink.astro`
     hardcodes `#_top` as its only target, and `display: none` leaves the skip
     link pointing at nothing focusable: with the bar now rendering here, that
     would be six header controls a keyboard user has to tab through with no
     way past them. Clipped instead, so the target stands. */
  h1#_top {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The landing's own `.wrap` supplies the width and the gutters. */
  .page .main-frame main {
    padding: 0;
  }

  .content-panel {
    padding: 0;
  }

  .content-panel + .content-panel {
    border-top: 0;
  }

  .sl-container {
    max-width: none;
    margin-inline: 0;
  }

  .sl-container > * + * {
    margin-top: 0;
  }
</style>
