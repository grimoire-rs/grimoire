{{!--
    Grimoire site root.

    mdBook renders this template for every page. `is_index` is true only for
    the generated site root (grimoire.rs/), so the landing page below replaces
    it while every chapter — `introduction.html` included — still renders
    through the stock mdBook branch after `{{else}}`.

    The landing branch is a standalone document: it loads none of mdBook's CSS
    or JS, so the theme switcher does not reach it. It commits to one dark
    look, tuned to sit next to the `navy` docs theme.

    Fully self-contained by contract — no CDN, no webfont, no external script.
    Indigo is an accent only: hairlines and one faint glow, never a filled
    panel.

    Client marks are inlined from @lobehub/icons-static-svg (MIT,
    Copyright (c) 2025 LobeHub) — every client except Zed, whose mark comes
    from Simple Icons (CC0-1.0). The card icons for the package index and
    the VS Code extension are drawn here: neither icon set carries a
    Visual Studio Code mark, and a puzzle piece is the generic symbol for
    an editor extension rather than anyone's trademark. All brand marks
    remain the trademarks of their owners and appear as nominative
    reference to the clients grim installs into.

    The `{{else}}` branch is mdBook 0.5.3's default `index.hbs`, byte for byte.
    Re-copy it from `mdbook init --theme` when mdBook is upgraded — a stock
    template change is invisible until someone diffs it.
--}}
{{#if is_index}}
<!DOCTYPE HTML>
<html lang="{{ language }}" dir="{{ text_direction }}">
    <head>
        <meta charset="UTF-8">
        <title>{{ book_title }} — a lockfile for your AI-agent config</title>
        <meta name="description" content="{{ description }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#161826">
        {{#if favicon_svg}}
        <link rel="icon" href="{{ resource "favicon.svg" }}">
        {{/if}}
        {{#if favicon_png}}
        <link rel="shortcut icon" href="{{ resource "favicon.png" }}">
        {{/if}}
        <style>
:root {
  --color-bg: #161826;
  --color-text: #e9e9ed;
  --color-accent: #9184d9;
  --color-accent-300: #d2cefd;
  --color-accent-900: #2b2741;
  --color-neutral-700: #595d6c;
  --color-neutral-800: #3f424d;
  --radius-sm: 4px;
  --radius-md: 8px;
  --font-heading: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-body: var(--font-heading);
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.55;
  color: var(--color-text);
  text-wrap: pretty;
  background:
    radial-gradient(1100px 640px at 88% -220px, color-mix(in srgb, var(--color-accent-900) 62%, transparent), transparent 62%),
    var(--color-bg);
}

a { color: var(--color-accent-300); text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent); text-underline-offset: 3px; }
a:hover { color: var(--color-accent); }
:focus { outline: none; }
:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
::selection { background: color-mix(in srgb, var(--color-accent) 30%, transparent); }

.wrap { max-width: 1160px; margin: 0 auto; padding-inline: clamp(20px, 5vw, 64px); }
.mono { font-family: var(--font-mono); }
.kicker { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; color: color-mix(in srgb, var(--color-text) 55%, transparent); }
.spacer { flex: 1; }
.dim { color: color-mix(in srgb, var(--color-text) 52%, transparent); }

pre { margin: 0; overflow-x: auto; font-family: var(--font-mono); }
pre::-webkit-scrollbar { height: 6px; }
pre::-webkit-scrollbar-thumb { background: var(--color-neutral-700); border-radius: 6px; }

/* — calls to action — */
.cta {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 20px; border-radius: var(--radius-md);
  font-family: var(--font-heading); font-weight: 500; font-size: 14.5px; line-height: 1.2;
  text-decoration: none; white-space: nowrap;
}
.cta-primary { color: #14121f; background: var(--color-accent); }
.cta-primary:hover { color: #14121f; background: var(--color-accent-300); }
.cta-secondary { color: var(--color-text); border: 1px solid var(--color-neutral-700); }
.cta-secondary:hover { color: var(--color-text); background: color-mix(in srgb, var(--color-text) 7%, transparent); }

/* — invitation cards (shape borrowed from the ocx website's closing row) — */
.cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.card {
  display: flex; gap: 13px; align-items: flex-start;
  padding: 17px 18px; border-radius: var(--radius-md);
  border: 1px solid var(--color-neutral-800);
  text-decoration: none; color: inherit;
  transition: border-color 140ms ease, background-color 140ms ease;
}
.card:hover, .card:focus-visible {
  border-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
  background: color-mix(in srgb, var(--color-accent) 7%, transparent);
  color: inherit;
}
.card svg {
  display: block; flex: none; width: 21px; height: 21px; margin-top: 1px;
  fill: color-mix(in srgb, var(--color-text) 52%, transparent);
  transition: fill 140ms ease;
}
.card:hover svg, .card:focus-visible svg { fill: var(--color-accent); }
.card strong { display: block; font-weight: 500; font-size: 14px; line-height: 20px; margin-bottom: 3px; }
.card span { display: block; font-size: 12.5px; line-height: 19px; color: color-mix(in srgb, var(--color-text) 58%, transparent); }

/* — client marks — */
.clients { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 26px 8px; }
.client {
  display: flex; flex-direction: column; align-items: center; gap: 9px;
  text-align: center; text-decoration: none;
  color: color-mix(in srgb, var(--color-text) 58%, transparent);
  transition: color 140ms ease;
}
.client:hover, .client:focus-visible { color: var(--brand, var(--color-accent)); }
.client svg { display: block; width: 27px; height: 27px; fill: currentColor; }
.client .tile {
  width: 27px; height: 27px; display: grid; place-items: center;
  border: 1px solid currentColor; border-radius: 7px;
  font-family: var(--font-mono); font-size: 11px; line-height: 1;
}
.client .name {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.01em;
  color: color-mix(in srgb, var(--color-text) 62%, transparent);
}
.client:hover .name, .client:focus-visible .name { color: color-mix(in srgb, var(--color-text) 88%, transparent); }

/* — the fan-out: one declaration, the files each client actually gets.
     Flat and full width. Splitting it narrower clips
     `.github/instructions/rust-style.instructions.md`, and a truncated file
     path reads as a broken page rather than as something you can scroll. */
.fanout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 clamp(24px, 4vw, 56px); }
.fanout pre { font-size: 12.5px; line-height: 24px; }
.fanout > * + * { border-left: 1px solid var(--color-neutral-800); padding-left: clamp(24px, 4vw, 56px); }

/* — copy buttons: inert without JS, so they only appear once wired up — */
.cmd-copy { display: none; }
.js .cmd-copy {
  display: inline-flex; align-items: center; justify-content: center;
  flex: none; white-space: nowrap; cursor: pointer;
  font-family: var(--font-heading); font-weight: 500; font-size: 14px; line-height: 1.2;
  color: var(--color-accent); background: transparent;
  border: 1px solid transparent; border-radius: var(--radius-md);
  padding: 5.6px 2.8px;
  opacity: 0.45; transition: opacity 120ms ease;
}
.cmd-copy:hover { background: color-mix(in srgb, var(--color-accent) 10%, transparent); }
[data-cmd]:hover .cmd-copy, [data-cmd]:focus-within .cmd-copy { opacity: 1; }

/* — OS switch: radio + :has(), no script — */
[data-os-row] { display: flex; }
[data-osblock]:has(input[value="win"]:checked) [data-os-row="unix"] { display: none; }
[data-osblock]:not(:has(input[value="win"]:checked)) [data-os-row="win"] { display: none; }
[data-osopt] { white-space: nowrap; cursor: pointer; color: color-mix(in srgb, var(--color-text) 45%, transparent); transition: color 120ms ease; }
[data-osopt]:hover { color: color-mix(in srgb, var(--color-text) 75%, transparent); }
[data-osopt]:has(input:checked) { color: var(--color-accent); }
[data-osopt] input { position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none; }
[data-osopt]:has(input:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: var(--radius-sm); }

/* Single-column collapse. `minmax(0, 1fr)`, never bare `1fr` — a bare `fr`
   track floors at min-content, which a long command or file path pushes wider
   than the viewport. The zero floor lets each `pre` scroll inside itself. */
@media (max-width: 940px) {
  [data-hero] { grid-template-columns: minmax(0, 1fr) !important; gap: 44px 0 !important; }
  .fanout { grid-template-columns: minmax(0, 1fr); }
  .fanout > * + * { border-left: 0; padding-left: 0; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--color-neutral-800); }
  [data-spec] { grid-template-columns: minmax(0, 1fr) !important; gap: 0 !important; }
}
@media (max-width: 940px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) {
  [data-navlinks] { display: none !important; }
  .clients { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 8px; }
  .cards { grid-template-columns: minmax(0, 1fr); }
}
        </style>
    </head>
