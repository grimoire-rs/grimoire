  <footer class="mono" style="padding:0 0 clamp(40px,5vw,70px); border-top:1px solid var(--color-neutral-800); padding-top:22px; display:flex; flex-wrap:wrap; gap:12px 32px; align-items:baseline; font-size:12.5px; line-height:24px">
