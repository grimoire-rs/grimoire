<section id="install" style="border-block:1px solid var(--color-neutral-800)">
  <div class="wrap" data-osblock style="padding-block:clamp(28px,3vw,40px)">
    <div style="display:flex; align-items:center; gap:14px; padding-bottom:12px">
      <span class="mono" role="radiogroup" aria-label="Platform" style="display:flex; align-items:baseline; gap:22px; font-size:12.5px; letter-spacing:0.04em">
        <label data-osopt><input type="radio" name="os" value="unix" checked>macOS / Linux</label>
        <label data-osopt><input type="radio" name="os" value="win">Windows</label>
      </span>
      <span class="spacer"></span>
      <span class="mono dim" style="font-size:12.5px">the binary is grim</span>
    </div>
    <div data-os-row="unix" data-cmd style="align-items:center; gap:11.2px">
      <pre style="flex:1; min-width:0; font-size:13.5px; line-height:28px"><span style="color:var(--color-accent)">$ </span>curl --proto '=https' --tlsv1.2 -LsSf https://setup.grimoire.rs/sh | sh</pre>
      <button type="button" class="cmd-copy" data-copy="curl --proto '=https' --tlsv1.2 -LsSf https://setup.grimoire.rs/sh | sh">copy</button>
    </div>
    <div data-os-row="win" data-cmd style="align-items:center; gap:11.2px">
      <pre style="flex:1; min-width:0; font-size:13.5px; line-height:28px"><span style="color:var(--color-accent)">&gt; </span>irm https://setup.grimoire.rs/ps1 | iex</pre>
      <button type="button" class="cmd-copy" data-copy="irm https://setup.grimoire.rs/ps1 | iex">copy</button>
    </div>
    <p class="mono dim" style="font-size:12px; line-height:20px; margin:10px 0 0">The installer verifies a SHA-256 checksum before it writes anything. <a href="{{ path_to_root }}installation.html">Other install methods</a>.</p>
  </div>
</section>

<div class="wrap">
  <section style="padding:clamp(36px,4vw,52px) 0 clamp(28px,3vw,40px)">
    <div style="display:flex; align-items:baseline; gap:14px; border-bottom:1px solid var(--color-neutral-700); padding-bottom:11.2px">
      <span class="mono" style="font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--color-accent)">quick start</span>
      <span class="spacer"></span>
      <span class="mono dim" style="font-size:12px">copy any line</span>
    </div>
    <div style="padding-top:14px">
      <div data-cmd style="display:flex; align-items:center; gap:11.2px; padding:2px 0">
        <pre style="flex:1; min-width:0; font-size:13.5px; line-height:30px"><span style="color:var(--color-accent)">$ </span>grim init<span class="dim">                                        # create grimoire.toml</span></pre>
        <button type="button" class="cmd-copy" data-copy="grim init">copy</button>
      </div>
      <div data-cmd style="display:flex; align-items:center; gap:11.2px; padding:2px 0">
        <pre style="flex:1; min-width:0; font-size:13.5px; line-height:30px"><span style="color:var(--color-accent)">$ </span>grim add ghcr.io/grimoire-rs/skills/grim-usage<span class="dim">   # declare, lock, install</span></pre>
        <button type="button" class="cmd-copy" data-copy="grim add ghcr.io/grimoire-rs/skills/grim-usage">copy</button>
      </div>
      <div data-cmd style="display:flex; align-items:center; gap:11.2px; padding:2px 0">
        <pre style="flex:1; min-width:0; font-size:13.5px; line-height:30px"><span style="color:var(--color-accent)">$ </span>grim install<span class="dim">                                     # re-materialize after a clone</span></pre>
        <button type="button" class="cmd-copy" data-copy="grim install">copy</button>
      </div>
      <div data-cmd style="display:flex; align-items:center; gap:11.2px; padding:2px 0">
        <pre style="flex:1; min-width:0; font-size:13.5px; line-height:30px"><span style="color:var(--color-accent)">$ </span>grim update<span class="dim">                                      # roll the pins forward</span></pre>
        <button type="button" class="cmd-copy" data-copy="grim update">copy</button>
      </div>
    </div>
  </section>

  <section class="fanout" style="padding:clamp(20px,2.4vw,30px) 0 clamp(36px,4vw,52px)">
    <div>
      <p class="kicker">one declaration</p>
      <pre><span class="dim"># grimoire.toml</span>
[rules]
rust-style = <span style="color:var(--color-accent-300)">"ghcr.io/acme/rust-style:2"</span>

<span class="dim"># grimoire.lock pins it to a digest
# ghcr.io/acme/rust-style@sha256:9f2c…</span></pre>
    </div>
    <div>
      <p class="kicker">what grim install writes</p>
      <pre>.claude/rules/rust-style.md
.cursor/rules/rust-style.mdc
.github/instructions/rust-style.instructions.md
.kiro/steering/rust-style.md
.opencode/rules/rust-style.md
<span class="dim">five clients decline rules — reported, not faked</span></pre>
    </div>
  </section>

  <section style="padding:0 0 clamp(36px,4vw,52px)">
    <div style="border-top:1px solid var(--color-neutral-700)">
      <div data-spec style="display:grid; grid-template-columns:170px minmax(0,1fr); gap:0 clamp(20px,3vw,42px); padding:13px 0; border-bottom:1px solid var(--color-neutral-800)">
        <div class="mono dim" style="font-size:13px; line-height:26px">artifacts</div>
        <div style="font-size:15px; line-height:26px">skills · rules · agents · MCP servers · bundles that group them</div>
      </div>
      <div data-spec style="display:grid; grid-template-columns:170px minmax(0,1fr); gap:0 clamp(20px,3vw,42px); padding:13px 0; border-bottom:1px solid var(--color-neutral-800)">
        <div class="mono dim" style="font-size:13px; line-height:26px">storage</div>
        <div style="font-size:15px; line-height:26px">any OCI registry · publish your own · <a href="{{ path_to_root }}package-index.html">the index is self-hostable</a></div>
      </div>
      <div data-spec style="display:grid; grid-template-columns:170px minmax(0,1fr); gap:0 clamp(20px,3vw,42px); padding:13px 0; border-bottom:1px solid var(--color-neutral-800)">
        <div class="mono dim" style="font-size:13px; line-height:26px">interface</div>
        <div style="font-size:15px; line-height:26px">0.11.1, stabilizing toward 1.0 — <a href="{{ path_to_root }}stability.html">released surfaces are frozen contracts</a>, with JSON output for scripting</div>
      </div>
